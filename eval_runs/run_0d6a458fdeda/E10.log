      "function": {
        "name": "run_sql",
        "arguments": "{\"sql\": \"SELECT p.category AS category, ROUND(SUM(oi.quantity * oi.unit_price_cents) / 100.0, 2) AS sales_amount_yuan FROM orders o JOIN order_items oi ON oi.order_id = o.order_id JOIN products p ON p.product_id = oi.product_id WHERE o.status = 'paid' GROUP BY p.category ORDER BY sales_amount_yuan DESC\", \"params\": []}"
